# Copy this file to .env and fill in real values.
# Generate a secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to a local SQLite file if unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/appdb

# Optional. JWT lifetime in days. Defaults to 7.
# TOKEN_EXPIRE_DAYS=7

# Optional. Comma-separated list of allowed origins for CORS.
# Defaults to "*" (any origin) — fine for local dev, tighten before deploying.
# CORS_ORIGINS=https://myapp.com,https://admin.myapp.com
